# Copy to .env.local (git-ignored) for `pnpm dev`. Everything is optional; the first provider that's available answers:
# Gemini → Claude → (Cloudflare Workers AI, deployed only) → local Ollama → offline generator.

# Google Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Local model (free): install Ollama from https://ollama.com, then run `ollama pull qwen2.5:7b`.
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA=off            # skip Ollama even if it's running

# Claude (paid): used if set and Gemini isn't. In production, set keys as secrets in Cloudflare Pages instead.
# ANTHROPIC_API_KEY=

# Dev only: the dev server skips the /api/theme rate limit. Set to "on" to test it locally.
# RATE_LIMIT=on
