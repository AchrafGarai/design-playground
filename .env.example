# Copy to .env.local (git-ignored) for `pnpm dev`. Everything is optional; the first provider that's available answers:
# Gemini → Claude → (Cloudflare Workers AI, deployed only) → local Ollama → offline generator.

# Google Gemini: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Local model (free): install Ollama from https://ollama.com, then run `ollama pull qwen2.5:7b`.
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA=off            # skip Ollama even if it's running

# Claude (paid): used if set and Gemini isn't. In production, set keys as secrets in Cloudflare Pages instead.
# ANTHROPIC_API_KEY=

# Dev only: the dev server skips the /api/theme rate limit. Set to "on" to test it locally.
# RATE_LIMIT=on

# Optional: OpenRouter (one key, many models). Free models end in ":free" and can be rate limited.
# OPEN_ROUTER_API_KEY=
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# OpenRouter is tried first by default. To try Gemini first instead:
# THEME_PROVIDER=gemini

# Dev only: use Claude through your Claude Code login (the local `claude` CLI), no API key. Tried first; slower
# (a few seconds per theme) and counts against your Claude plan. Never used on the live site.
# THEME_PROVIDER=claude
# CLAUDE_CLI_MODEL=sonnet
